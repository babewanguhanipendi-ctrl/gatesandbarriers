{
  "name": "gatesandbarriers",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development --host 127.0.0.1 --port 3000",
    "start": "npm run build && npm run server",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "db:migrate": "npm --prefix server run migrate",
    "lint": "oxlint"
  },
  "browser": {
    "fs": false,
    "path": false,
    "os": false
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.24.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "esbuild": "^0.28.0",
    "html-webpack-plugin": "^5.5.3",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.19",
    "postcss-loader": "^8.2.1",
    "style-loader": "^3.3.3",
    "tailwindcss": "^4.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6"
  }
